# Local dev + Vercel should use the pooled Neon connection for app traffic.
DATABASE_URL="postgresql://USER:PASSWORD@ep-example-pooler.us-east-2.aws.neon.tech/DB_NAME?sslmode=require&channel_binding=require"

# Prisma schema pushes/migrations should use the direct Neon connection.
DIRECT_URL="postgresql://USER:PASSWORD@ep-example.us-east-2.aws.neon.tech/DB_NAME?sslmode=require&channel_binding=require"

KEEPER_GOOGLE_SHEET_URL=""
GOOGLE_SHEETS_WRITEBACK_WEBHOOK_URL=""

# Twilio inbound trade-text webhook validation.
# Set the Messaging webhook URL in Twilio to:
# https://YOUR_DOMAIN/api/sms/twilio
TWILIO_AUTH_TOKEN=""
TWILIO_WEBHOOK_BASE_URL="https://YOUR_DOMAIN"
