{
  "name": "fantasy-keeper-hq",
  "private": true,
  "scripts": {
    "dev": "NEXT_TEST_WASM_DIR=./node_modules/@next/swc-wasm-nodejs next dev",
    "assistant:dev": "npm --prefix draft-assistant run dev",
    "build": "prisma generate && NEXT_TEST_WASM_DIR=./node_modules/@next/swc-wasm-nodejs next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "node --test --import tsx tests/**/*.test.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "db:seed": "node prisma/seed.js",
    "db:reset": "prisma db push --accept-data-loss && node prisma/seed.js"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^6.16.3",
    "clsx": "^2.1.1",
    "lucide-react": "^1.8.0",
    "next": "^15.5.15",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@next/swc-wasm-nodejs": "15.5.15",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.5.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.4",
    "postcss": "^8.5.10",
    "prisma": "^6.16.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  }
}
